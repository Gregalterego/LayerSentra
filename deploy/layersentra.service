# Example: install the project and venv in /opt/layersentra, owned by layersentra.
# Install this unit only after local configuration and observation are verified.
[Unit]
Description=LayerSentra local AI print monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=layersentra
Group=layersentra
WorkingDirectory=/opt/layersentra
ExecStart=/opt/layersentra/.venv/bin/python -m layersentra.app --observe
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
