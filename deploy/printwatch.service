# Example: install the project and venv in /opt/printwatch, owned by printwatch.
# Install this unit only after local configuration and observation are verified.
[Unit]
Description=PrintWatch local AI print monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=printwatch
Group=printwatch
WorkingDirectory=/opt/printwatch
ExecStart=/opt/printwatch/.venv/bin/python -m printwatch.app --observe
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
